DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nusantara_card?schema=public"
# Optional source DB for one-time data migration: pnpm db:migrate:data
LEGACY_DATABASE_URL=""
# Set to "prisma" when a live PostgreSQL server is running at DATABASE_URL, or "embedded" for zero-config local file-backed DB
NUSANTARA_STORAGE_DRIVER="embedded"
# Required in production for encrypted, revealable battle RNG seeds (64 hex chars).
BATTLE_RNG_ENCRYPTION_KEY=""
# Protects the internal timeout and expired-escrow sweep endpoint (minimum 32 chars).
BATTLE_SWEEP_SECRET=""
# Use a unique random secret of at least 32 characters.
JWT_SECRET="generate-a-unique-random-secret-at-least-32-characters"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Solana Wallet Auth (Devnet)
NEXT_PUBLIC_SOLANA_NETWORK="devnet"
NEXT_PUBLIC_SOLANA_RPC_URL="https://api.devnet.solana.com"

# Admin Authentication (set unique server-side credentials)
ADMIN_USERNAME=""
# Production requires a bcrypt hash (cost 10+); local development may use ADMIN_PASSWORD.
ADMIN_PASSWORD_HASH=""
ADMIN_PASSWORD=""

# Menu Kita iPaymu bridge. Use the Menu Kita API origin, not an endpoint path.
MENU_KITA_PAYMENT_BRIDGE_URL=""
NUSA_WARRIOR_PAYMENT_BRIDGE_KEY=""
# Must match NUSA_WARRIOR_BRIDGE_CALLBACK_SECRET in Menu Kita API.
NUSA_WARRIOR_PAYMENT_CALLBACK_SECRET=""

# Remote File Storage (Excitech / Menu Kita Storage API)
REMOTE_STORAGE_URL="https://excitech-id.my.id"
REMOTE_STORAGE_2_URL="https://storage.excitech.id"
REMOTE_STORAGE_TOKEN=""
